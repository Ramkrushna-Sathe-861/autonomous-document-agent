# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here

# Application Configuration
API_TITLE=Autonomous Document Generation Agent
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Model Configuration
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PLANNER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
EXECUTOR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
REFLECTION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Paths
OUTPUT_DIR=output
TEMPLATES_DIR=templates
LOGS_DIR=logs

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=app.log

# Document Configuration
DOCUMENT_AUTHOR=Autonomous Document Agent
DOCUMENT_COMPANY=AI Systems
DOCUMENT_FONT_NAME=Calibri
DOCUMENT_FONT_SIZE=11

# Validation Configuration
MAX_DOCUMENT_SECTIONS=50
MIN_DOCUMENT_LENGTH=100
MAX_DOCUMENT_LENGTH=50000
